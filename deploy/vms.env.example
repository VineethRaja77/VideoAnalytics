# Copy to /etc/vms/vms.env (referenced by vms-app.service) and fill in real values.

DATABASE_URL=postgresql://vms:CHANGE_ME@localhost:5432/rest_express

RECORDINGS_BASE=/var/lib/vms/recordings

MTX_API_BASE=http://127.0.0.1:9997
MTX_RTSP_PORT=8554
MTX_WEBRTC_PORT=8889
MTX_HLS_PORT=8888

GST_LAUNCH_PATH=gst-launch-1.0
GST_INSPECT_PATH=gst-inspect-1.0

# Generate with: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME

PORT=5002
NODE_ENV=production

# ---------------------------------------------------------------------------
# STORAGE MONITORING
# A VMS writes continuously. Without these, the first symptom of a full disk is
# recording, analytics and Postgres failing at once with errors that never
# mention the disk. Client admins are notified at each threshold.
# ---------------------------------------------------------------------------
STORAGE_WARN_PERCENT=85
STORAGE_CRITICAL_PERCENT=93
# Absolute floor — a percentage is meaningless on a large array.
STORAGE_MIN_FREE_GB=5
STORAGE_CHECK_INTERVAL_MS=300000

# ---------------------------------------------------------------------------
# AUDIT TRAIL
# Retention is OFF by default (0 = keep forever): silently discarding a
# compliance record is worse than using disk. When set, a 365-day floor applies.
# ---------------------------------------------------------------------------
AUDIT_RETENTION_DAYS=0

# Set to true ONLY when the app sits behind a reverse proxy you control.
# Otherwise any caller can forge X-Forwarded-For and write a false origin IP
# into the audit trail.
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# BACKUP  (scripts/backup.sh — run nightly from cron)
#   15 2 * * *  /opt/vms/scripts/backup.sh >> /var/log/vms/backup.log 2>&1
#
# WARNING: a database backup WITHOUT SECRET_ENCRYPTION_KEY restores to a system
# where every camera credential is unrecoverable. Store the key SEPARATELY from
# the dumps — together in one place and the encryption bought you nothing.
# ---------------------------------------------------------------------------
BACKUP_DIR=/var/backups/vms
BACKUP_RETENTION_DAYS=30
BACKUP_INCLUDE_KEYS=false

# ---------------------------------------------------------------------------
# SESSION LIFETIME
# Idle timeout resets on every request, so an everyday user is never logged out.
# The absolute cap does NOT reset — it is the control that matters, because a
# cookie copied off a device would otherwise stay valid forever while in use.
# ---------------------------------------------------------------------------
SESSION_IDLE_DAYS=30
SESSION_ABSOLUTE_DAYS=90

# ---------------------------------------------------------------------------
# CSRF
# SameSite=lax compares the REGISTRABLE DOMAIN, so a sibling subdomain
# (label.example.com vs vms.example.com) is treated as same-site and gets no
# protection from it. Every state-changing request is therefore origin-checked.
# Leave unset for a normal single-origin install; set it only when the UI is
# served from a different host than the API.
# ---------------------------------------------------------------------------
# ALLOWED_ORIGINS=https://vms.example.com

# ---------------------------------------------------------------------------
# RECORDING
# Shorter segments = finer retention granularity and less footage lost when a
# recorder dies mid-segment, at the cost of more files and more database rows.
# ---------------------------------------------------------------------------
RECORDING_SEGMENT_SECONDS=600

# Refuse to start if the database schema is behind this build (recommended).
# ALLOW_SCHEMA_DRIFT=false
# Development only — store camera credentials unencrypted.
# ALLOW_PLAINTEXT_SECRETS=false

# ---------------------------------------------------------------------------
# SENSORS  (optional — omit entirely on a video-only install)
# Physical telemetry: parking bays, tank level, water pH, diesel, energy.
# Gateways can POST to /api/sensors/readings with the org's X-Ingest-Key, or
# publish MQTT to  vms/<orgToken>/<deviceId>/<metric>.
#
# The topic carries the token because MQTT 3.1.1 has no per-message auth, so the
# broker MUST be on a private network or TLS. Prefer HTTP where the gateway can
# set headers.
# ---------------------------------------------------------------------------
# MQTT_URL=mqtt://127.0.0.1:1883
# MQTT_USERNAME=
# MQTT_PASSWORD=

# Location hierarchy (group -> site -> building -> floor -> zone) needs no
# configuration; migration 0008 creates it and the tree is per-tenant.
