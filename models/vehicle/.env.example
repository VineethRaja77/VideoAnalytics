# Copy to .env and adjust.

# MediaMTX re-published stream for the camera to analyze.
SOURCE_RTSP=rtsp://127.0.0.1:8554/cam_21ff3d14c94c4c4eb385ac82e46b7604
CAMERA_ID=21ff3d14-c94c-4c4e-b385-ac82e46b7604

# Model (trained on BMD-45 Bengaluru CCTV; mAP50 0.891)
MODEL_PATH=weights/vehicle_best.pt

# Inference. Traffic is fast — do not drop below ~5 fps or vehicles cross the
# counting line between sampled frames and are missed.
SAMPLE_FPS=10
IMG_SIZE=960          # must match training imgsz
CONF=0.25             # detector floor; per-class thresholds applied after
AGNOSTIC_NMS=true     # one box per vehicle, not one per class

# Counting line "x1,y1,x2,y2" in image space. Empty = detect only, no counting.
COUNT_LINE=

# Temporal class voting (stops per-frame class flicker)
VOTE_WINDOW=30
VOTE_MIN_FRAMES=5
VOTE_LOCK_FRAMES=12

# Where to send events. POST_EVENTS=false just prints (dev).
POST_EVENTS=false
PLATFORM_API=https://vms.hyperspark.in
VEHICLE_INGEST_KEY=
TRACK_GRACE_FRAMES=30
