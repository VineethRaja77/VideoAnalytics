# Copy to .env and adjust.

SOURCE_RTSP=rtsp://127.0.0.1:8554/cam_21ff3d14c94c4c4eb385ac82e46b7604
CAMERA_ID=21ff3d14-c94c-4c4e-b385-ac82e46b7604

# Models (both commercially licensed — see README)
DETECTOR_PATH=weights/face_detection_yunet_2023mar.onnx
FACE_BACKEND=auraface
EMBEDDER_PATH=weights/auraface_glintr100.onnx
GALLERY_PATH=gallery/gallery.npz

# Recognition. TUNE THESE ON YOUR OWN PEOPLE + a stranger set.
MATCH_THRESHOLD=0.40    # cosine; below this -> unknown
MATCH_MARGIN=0.05       # best must beat runner-up by this, else -> unknown

# Quality gate — interocular px below which we do NOT attempt recognition.
# <20 detection only | 40 usable | 80+ reliable
MIN_EYE_DISTANCE_PX=40
DETECT_CONF=0.7

SAMPLE_FPS=6
VOTE_MIN_FRAMES=3
VOTE_LOCK_FRAMES=8
TRACK_GRACE_FRAMES=20
ALERT_COOLDOWN_S=60
ALERT_ON_UNKNOWN=true

POST_EVENTS=false
PLATFORM_API=https://vms.hyperspark.in
FACE_INGEST_KEY=

# DPDP: storing images of unidentified people needs a documented lawful basis.
SAVE_SNAPSHOTS=true
SAVE_UNKNOWN_SNAPSHOTS=false
