# Copy to .env and adjust. The platform supervisor normally sets these.
SOURCE_RTSP=rtsp://127.0.0.1:8554/cam_21ff3d14c94c4c4eb385ac82e46b7604
CAMERA_ID=21ff3d14-c94c-4c4e-b385-ac82e46b7604
ENABLED_FEATURES=object_left,object_removed

SAMPLE_FPS=2
WARMUP_FRAMES=60

# Two background models at different rates; their difference isolates
# "arrived, then stopped moving".
SLOW_LR=0.0005
FAST_LR=0.02

MIN_AREA_FRAC=0.0008
MAX_AREA_FRAC=0.25

# How long an object must sit still to count as abandoned.
PERSIST_SECONDS=30
GONE_SECONDS=5

# Edge-density change deciding LEFT vs REMOVED. Ambiguous cases report nothing.
EDGE_DELTA=0.25
COOLDOWN_SECONDS=300
PROC_WIDTH=480

# Polygon "x1,y1,x2,y2,..." — without it a parked car is (correctly) a left object.
OBJECT_ZONE=

POST_EVENTS=false
PLATFORM_API=https://vms.hyperspark.in
ANALYTICS_INGEST_KEY=
SAVE_SNAPSHOTS=true
