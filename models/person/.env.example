# Copy to .env and adjust. The platform supervisor normally sets these.

SOURCE_RTSP=rtsp://127.0.0.1:8554/cam_21ff3d14c94c4c4eb385ac82e46b7604
CAMERA_ID=21ff3d14-c94c-4c4e-b385-ac82e46b7604

# WHICH ANALYTICS TO RUN. Set by the supervisor from the org's LICENSED
# features — an unlicensed rule is never constructed. Empty = run nothing.
ENABLED_FEATURES=intrusion,people_count,loitering

MODEL_PATH=weights/person_rfdetr.onnx
SAMPLE_FPS=6
CONF=0.40
MIN_HEIGHT_PX=40

# Zones are image-space polygons "x1,y1,x2,y2,x3,y3,..." (>=3 points).
# INTRUSION_ZONE is the fallback for the other zone rules, so a simple site
# only needs one polygon. Empty polygon = watch the whole frame.
INTRUSION_ZONE=
LOITER_ZONE=
CROWD_ZONE=
QUEUE_ZONE=

# Lines are "x1,y1,x2,y2"
COUNT_LINE=
TAILGATE_LINE=

INTRUSION_MIN_FRAMES=3
LOITER_SECONDS=60
CROWD_LIMIT=10
TAILGATE_WINDOW_S=3
TAILGATE_PEOPLE=2
FALL_ASPECT=1.0
FALL_HOLD_S=2.0
ALERT_COOLDOWN_S=60

POST_EVENTS=false
PLATFORM_API=https://vms.hyperspark.in
ANALYTICS_INGEST_KEY=

# DPDP: only ALERT events store an image; counting never does.
SAVE_SNAPSHOTS=true
SNAPSHOT_EVENTS=intrusion,loitering,fall,tailgating
