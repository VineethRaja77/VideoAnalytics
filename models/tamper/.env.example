# Copy to .env and adjust. The platform supervisor normally sets these.

SOURCE_RTSP=rtsp://127.0.0.1:8554/cam_21ff3d14c94c4c4eb385ac82e46b7604
CAMERA_ID=21ff3d14-c94c-4c4e-b385-ac82e46b7604
ENABLED_FEATURES=camera_tamper

# 1 fps is plenty — tampering persists, and this leaves CPU for the analytics
# that actually need frames.
SAMPLE_FPS=1

# Frames spent learning THIS camera's normal blur/edge levels before judging.
WARMUP_FRAMES=30
BASELINE_FRAMES=300

# Proportional drops from the learned baseline, not absolute values.
BLUR_DROP=0.45
EDGE_DROP=0.40
SCENE_CHANGE=0.45
DARK_LEVEL=12.0
FROZEN_DELTA=0.15

# The single biggest false-positive control: a truck passing close to the lens
# looks exactly like blocking for a second.
HOLD_SECONDS=5.0
COOLDOWN_SECONDS=300.0
PROC_WIDTH=320

POST_EVENTS=false
PLATFORM_API=https://vms.hyperspark.in
ANALYTICS_INGEST_KEY=
SAVE_SNAPSHOTS=true
