# Copy to .env and adjust.

# The MediaMTX re-published stream for the camera to analyze (NOT the camera
# directly). cam_<id> is the same path the platform uses — strip dashes from
# the camera UUID. Or point at any RTSP URL for testing.
SOURCE_RTSP=rtsp://127.0.0.1:8554/cam_21ff3d14c94c4c4eb385ac82e46b7604

# Which camera these events belong to (the platform camera id).
CAMERA_ID=21ff3d14-c94c-4c4e-b385-ac82e46b7604

# YOLO weights. Drop a PPE-trained .pt in weights/ (e.g. a hardhat/vest model).
# Falls back to a generic yolo model that only knows "person" if absent.
MODEL_PATH=weights/ppe.pt

# Inference settings
SAMPLE_FPS=2            # frames analyzed per second (2 is plenty for PPE)
CONF_THRESHOLD=0.4      # min detection confidence
IMG_SIZE=640

# Where to send events. Leave POST_EVENTS=false to just print (dev).
POST_EVENTS=false
PLATFORM_API=https://vms.hyperspark.in
# A service token/session for the platform events endpoint (added later).
PLATFORM_TOKEN=
